# Auth — enkel passordbasert innlogging (ingen ekstern tjeneste)
# Generer SESSION_SECRET: openssl rand -base64 32
SESSION_SECRET=your-random-32-char-secret-here
ADMIN_PASSWORD=your-secure-password-here

# Notion API — for henting av eiendommer
# Hent token fra https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your_notion_integration_token_here
NOTION_DATABASE_ID=33b1573c-e82d-80e6-ae7e-f008c4a26fa6

# App URL (trengs for produksjon)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Åpne datakilder — ingen nøkler nødvendig
# Norges Bank: https://data.norges-bank.no/api/data/EXR/B.EUR.NOK.SP?format=sdmx-json&lastNObservations=1
# Eurostat:    https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data/PRC_HPI_A
# Banca d'Italia: manuell innlegging (ingen åpent API)

# Claude API — for AI-genererte tekstutkast
# Hent fra console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# NewsAPI — for automatiske nyheter om italiensk eiendomsmarked
# Gratis konto på newsapi.org (100 req/dag)
NEWSAPI_KEY=your-newsapi-key-here

# Notion kunnskapsbank — valgfri, for AI-kontekst
# Database-ID fra Notion-databasen din med artikler/notater
NOTION_KNOWLEDGE_DB_ID=optional-database-id

# E-postdistribusjon via Titan Mail (SMTP)
# Innstillinger fra Titan-kontoen din (titan.email)
SMTP_HOST=smtp.titan.email
SMTP_PORT=587
SMTP_USER=din@epost.no
SMTP_PASS=ditt-titan-passord

# Rapportarkiv i Notion (valgfri)
# ID til en Notion-database for lagring av rapporter
NOTION_ARCHIVE_DB_ID=optional-archive-database-id
