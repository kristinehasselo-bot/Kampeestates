# Auth — enkel passordbasert innlogging (ingen ekstern tjeneste)
# Generer SESSION_SECRET: openssl rand -base64 32
SESSION_SECRET=your-random-32-char-secret-here
ADMIN_PASSWORD=your-secure-password-here

# Notion API — for henting av eiendommer
# Hent token fra https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your_notion_integration_token_here
NOTION_DATABASE_ID=33b1573c-e82d-80e6-ae7e-f008c4a26fa6

# App URL (trengs for produksjon)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Åpne datakilder — ingen nøkler nødvendig
