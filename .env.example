# Supabase - Authentication & Storage
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Notion API - For fetching property listings
# Get this from https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your_notion_integration_token_here
# The Notion database ID for property listings (already configured)
NOTION_DATABASE_ID=33b1573c-e82d-80e6-ae7e-f008c4a26fa6

# Optional: App URL (needed for OAuth callbacks in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data sources (no keys needed, these are public APIs)
# Norges Bank EXR API: https://data.norges-bank.no/api/data/EXR/B.EUR.NOK.SP?format=sdmx-json&lastNObservations=1
# Eurostat HPI API: https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data/PRC_HPI_A
# Banca d'Italia: Manual data entry required (no public API)
